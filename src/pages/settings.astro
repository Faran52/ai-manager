---
import { SettingsApp } from '@features/app-shell';
import AppDocument from '../layouts/AppDocument.astro';

/*
 * The Settings window's own document: a second window, so it boots its own app
 * on top of the shared shell, where the stored appearance is settled.
 */
export const prerender = false;
---

<AppDocument title="AI Manager Settings">
	<SettingsApp client:only="react" />
</AppDocument>
