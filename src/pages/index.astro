---
import { languageStorageKey } from '@config/storageKeys';
import { HistoryApp } from '@features/app-shell';
import ar from '../i18n/locales/ar/common.json';
import en from '../i18n/locales/en/common.json';
import ja from '../i18n/locales/ja/common.json';
import ko from '../i18n/locales/ko/common.json';
import zhCN from '../i18n/locales/zh-CN/common.json';
import zhTW from '../i18n/locales/zh-TW/common.json';
import AppDocument from '../layouts/AppDocument.astro';

/*
 * The island is client:only, so nothing is painted until the bundle hydrates: on a
 * cold start, a blank window. The fallback fills it and Astro drops it on takeover.
 * The label comes from the locale files, English until the inline script swaps it.
 */
const startingUp = {
  ar: ar.startingUp,
  en: en.startingUp,
  ja: ja.startingUp,
  ko: ko.startingUp,
  'zh-CN': zhCN.startingUp,
  'zh-TW': zhTW.startingUp,
};
---

<AppDocument title="AI Manager" icons>
	<HistoryApp client:only="react">
		<div
			slot="fallback"
			class="flex h-dvh items-center justify-center bg-recess text-foreground"
			data-booting
		>
			<div class="loader">
				<div class="loader-mark"></div>
				<p class="loader-stage" data-booting-stage>{startingUp.en}</p>
			</div>
		</div>
	</HistoryApp>
	<script is:inline define:vars={{ languageStorageKey, startingUp }}>
	const stage = document.querySelector('[data-booting-stage]');
	const tag = localStorage.getItem(languageStorageKey) || navigator.language || 'en';
	const label = startingUp[tag] || startingUp[tag.split('-')[0]];
	if (stage && label) {
	  stage.textContent = label;
	}
	</script>
</AppDocument>
