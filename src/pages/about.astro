---
import { AboutApp } from '@features/app-shell';
import AppDocument from '../layouts/AppDocument.astro';

/*
 * The About window's own document: a second window, so it boots its own app on
 * top of the shared shell, where the stored appearance is settled.
 */
export const prerender = false;
---

<AppDocument title="About AI Manager">
	<AboutApp client:only="react" />
</AppDocument>
