# Copy to .env. Both values are public: the private signing key never leaves
# ~/.ai-manager and lives in CI as the UPDATE_SIGNING_KEY secret.
#
# astro.config.mjs inlines these into the bundle at build time, because a
# packaged app runs with the user's environment rather than the one that built
# it. Leave them unset and the build simply never offers updates.
UPDATE_FEED_URL=https://github.com/Faran52/ai-manager/releases/latest/download
UPDATE_PUBLIC_KEY=
