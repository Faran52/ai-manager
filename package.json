{
  "name": "ai-manager",
  "type": "module",
  "main": "scripts/desktopEntry.ts",
  "version": "0.2.0",
  "description": "A fast, local-first viewer for AI coding-session history.",
  "author": "Faran Ali",
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=26.8.1",
    "pnpm": ">=12.4.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\" --allow-empty-input",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix --allow-empty-input",
    "lint:types": "node scripts/lintTypes.ts",
    "lint:packaging": "node scripts/checkShellPackaging.ts",
    "typecheck": "astro sync && astro check",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm lint:types && pnpm lint:packaging && pnpm lint:css && pnpm typecheck && pnpm version:check && pnpm test:coverage && pnpm build",
    "prepare": "astro sync && husky",
    "desktop": "pnpm build && electron .",
    "version:check": "node scripts/syncVersion.ts",
    "version:set": "node scripts/syncVersion.ts",
    "desktop:pack": "pnpm build && electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^6.0.5",
    "@babel/core": "^8.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint-react/eslint-plugin": "^5.19.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@linteljs/eslint-config": "^1.5.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "astro": "^7.3.2",
    "astro-eslint-parser": "^3.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "clsx": "^2.1.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "es-toolkit": "^1.52.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lint-staged": "^17.5.0",
    "lucide-react": "^1.43.0",
    "motion": "^13.2.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stylelint": "^17.15.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
